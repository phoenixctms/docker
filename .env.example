# Copy to .env and adjust as needed

CTSMS_HTTP_PORT=8888
# Bind loopback by default; use 0.0.0.0 for LAN/VM access
CTSMS_BIND_ADDRESS=127.0.0.1
PUBLIC_URL=http://localhost:8888

POSTGRES_DB=ctsms
POSTGRES_USER=ctsms
POSTGRES_PASSWORD=ctsms

DEFAULT_LOCALE=en
JAVA_XMS=512m
JAVA_XMX=1536m

# Set true to load demo data during first seed
DEMO_DATA=false

# Host port for the optional Signup profile
SIGNUP_HTTP_PORT=3000

# Git refs used when building images (BULK_TAG is the bulk-processor ref used by app and signup)
CTSMS_TAG=master
CONFIG_TAG=master
MASTER_DATA_TAG=master
BULK_TAG=master

# Use published images instead of local build names:
# CTSMS_IMAGE=ghcr.io/phoenixctms/ctsms:latest
# SIGNUP_IMAGE=ghcr.io/phoenixctms/signup:latest
