# Copy to .env and adjust as needed

PHOENIX_HTTP_PORT=8888
# Bind loopback by default; use 0.0.0.0 for LAN/VM access
PHOENIX_BIND_ADDRESS=127.0.0.1
PUBLIC_URL=http://localhost:8888

POSTGRES_DB=ctsms
POSTGRES_USER=ctsms
POSTGRES_PASSWORD=ctsms

DEFAULT_LOCALE=en
JAVA_XMS=512m
JAVA_XMX=1536m

# Set true to load demo data during first seed
SEED_DEMO_DATA=false

# Git refs used when building images
CTSMS_TAG=master
CONFIG_TAG=master
MASTER_DATA_TAG=master
BULK_TAG=master

# Use published images instead of local build names:
# PHOENIX_IMAGE=ghcr.io/phoenixctms/phoenixctms-app:latest
# PHOENIX_BULK_IMAGE=ghcr.io/phoenixctms/phoenixctms-bulk:latest
