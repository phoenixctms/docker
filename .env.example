# Copy to .env and adjust as needed

PHOENIX_CTSMS_HTTP_PORT=8888
# Bind loopback by default; use 0.0.0.0 for LAN/VM access
PHOENIX_CTSMS_BIND_ADDRESS=127.0.0.1
PHOENIX_PUBLIC_URL=http://localhost:8888

PHOENIX_POSTGRES_DB=ctsms
PHOENIX_POSTGRES_USER=ctsms
PHOENIX_POSTGRES_PASSWORD=ctsms

PHOENIX_DEFAULT_LOCALE=en
PHOENIX_JAVA_XMS=512m
PHOENIX_JAVA_XMX=1536m

# Set true to load demo data during first seed
PHOENIX_DEMO_DATA=false

# Host port for the optional Signup profile
PHOENIX_SIGNUP_HTTP_PORT=3000

# Git refs used when building images (PHOENIX_BULK_TAG is the bulk-processor ref used by ctsms and signup)
PHOENIX_CTSMS_TAG=master
PHOENIX_CONFIG_TAG=master
PHOENIX_MASTER_DATA_TAG=master
PHOENIX_BULK_TAG=master

# Use published images instead of local build names:
# PHOENIX_CTSMS_IMAGE=ghcr.io/phoenixctms/ctsms:latest
# PHOENIX_SIGNUP_IMAGE=ghcr.io/phoenixctms/signup:latest
